<Window x:Class="ClickyWindows.Views.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        Width="320" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#FF101211"
            CornerRadius="12"
            BorderBrush="#FF373B39"
            BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="clicky"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="#FFECEEED"
                       Margin="0,0,0,4"/>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       Text="ready — hold ctrl+alt to talk"
                       FontSize="13"
                       Foreground="#FFADB5B2"
                       Margin="0,0,0,16"/>

            <!-- Push-to-talk instructions -->
            <Border Grid.Row="2"
                    Background="#FF171918"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="push-to-talk"
                               FontSize="14" FontWeight="Medium"
                               Foreground="#FFECEEED"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="hold ctrl+alt to speak. release to send your message along with a screenshot of your screen to claude."
                               FontSize="12"
                               Foreground="#FFADB5B2"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- Model Picker -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="model"
                           FontSize="12"
                           Foreground="#FF6B736F"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="ModelPicker"
                          SelectedIndex="0"
                          Background="#FF202221"
                          Foreground="#FFECEEED"
                          BorderBrush="#FF373B39"
                          FontSize="13"
                          Padding="8,6"
                          SelectionChanged="ModelPicker_SelectionChanged">
                    <ComboBoxItem Content="Claude Sonnet 4.6" Tag="claude-sonnet-4-6"/>
                    <ComboBoxItem Content="Claude Opus 4.6" Tag="claude-opus-4-6"/>
                </ComboBox>
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Row="4"
                    Height="1"
                    Background="#FF373B39"
                    Margin="0,0,0,12"/>

            <!-- Quit Button -->
            <Button Grid.Row="5"
                    Content="Quit Clicky"
                    FontSize="13"
                    Foreground="#FFECEEED"
                    Background="#FF202221"
                    BorderBrush="#FF373B39"
                    BorderThickness="1"
                    Padding="12,8"
                    Cursor="Hand"
                    Click="QuitButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}"
                                            Cursor="Hand">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF272A29"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#FF2E3130"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
