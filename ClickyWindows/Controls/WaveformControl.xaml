<UserControl x:Class="ClickyWindows.Controls.WaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="24">

    <!-- 5-bar waveform visualization, reactive to audio power level.
         Bar heights: base 3px + (easedPower * 10 * profile[i]) + idlePulse.
         Profile: [0.4, 0.7, 1.0, 0.7, 0.4] -->
    <Canvas x:Name="WaveformCanvas">
        <Rectangle x:Name="Bar0" Fill="#FF3B82F6" Width="4" Height="3" RadiusX="2" RadiusY="2"
                   Canvas.Left="2" Canvas.Bottom="12"/>
        <Rectangle x:Name="Bar1" Fill="#FF3B82F6" Width="4" Height="3" RadiusX="2" RadiusY="2"
                   Canvas.Left="10" Canvas.Bottom="12"/>
        <Rectangle x:Name="Bar2" Fill="#FF3B82F6" Width="4" Height="3" RadiusX="2" RadiusY="2"
                   Canvas.Left="18" Canvas.Bottom="12"/>
        <Rectangle x:Name="Bar3" Fill="#FF3B82F6" Width="4" Height="3" RadiusX="2" RadiusY="2"
                   Canvas.Left="26" Canvas.Bottom="12"/>
        <Rectangle x:Name="Bar4" Fill="#FF3B82F6" Width="4" Height="3" RadiusX="2" RadiusY="2"
                   Canvas.Left="34" Canvas.Bottom="12"/>
    </Canvas>
</UserControl>
