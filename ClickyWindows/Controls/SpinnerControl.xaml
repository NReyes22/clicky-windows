<UserControl x:Class="ClickyWindows.Controls.SpinnerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20">

    <!-- Spinning arc indicator matching the macOS BlueCursorSpinnerView.
         14x14 circle, angular gradient stroke trimmed to ~70% arc,
         rotating 360 degrees in 0.8s continuously. -->
    <Grid>
        <!-- Circular arc drawn as an ellipse with a dashed stroke to create the arc effect -->
        <Ellipse x:Name="SpinnerArc"
                 Width="14" Height="14"
                 Stroke="#FF3B82F6"
                 StrokeThickness="2.5"
                 StrokeDashArray="3.3 1.3"
HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF3B82F6"
                                  BlurRadius="6"
                                  ShadowDepth="0"
                                  Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>
