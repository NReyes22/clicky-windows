<UserControl x:Class="ClickyWindows.Controls.BlueCursorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="24" Height="24">

    <!-- Blue equilateral triangle rotated -35 degrees with glow effect.
         Matches the macOS BlueCursorView triangle cursor. -->
    <Canvas>
        <Polygon Points="12,2 22,19 2,19"
                 Fill="#FF3B82F6"
                 RenderTransformOrigin="0.5,0.5">
            <Polygon.RenderTransform>
                <RotateTransform Angle="-35"/>
            </Polygon.RenderTransform>
            <Polygon.Effect>
                <DropShadowEffect Color="#FF3B82F6"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.6"/>
            </Polygon.Effect>
        </Polygon>
    </Canvas>
</UserControl>
