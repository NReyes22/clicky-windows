<UserControl x:Class="ClickyWindows.Controls.SpeechBubbleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="300">

    <!-- Speech bubble for displaying Claude's response text next to the cursor.
         Text streams character-by-character with a pop-in spring animation. -->
    <Border x:Name="BubbleBorder"
            Background="#FF2563EB"
            CornerRadius="12"
            Padding="12,8"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#FF2563EB"
                              BlurRadius="12"
                              ShadowDepth="0"
                              Opacity="0.5"/>
        </Border.Effect>

        <TextBlock x:Name="BubbleText"
                   Text=""
                   Foreground="White"
                   FontSize="13"
                   FontWeight="Medium"
                   TextWrapping="Wrap"
                   MaxWidth="276"/>
    </Border>
</UserControl>
